{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "act: Local CI Build",
      "type": "shell",
      "command": "act --job build --reuse --artifact-server-path /tmp/act-artifacts 2>&1 | tee /tmp/act.log",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "never",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}