#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/dynamic_macros.h>
#include <behaviors/dynamic_macro.dtsi>

#define ALPHA       0
#define SYMBOL 2
#define NUMBER 1
#define NAVIGATION 3
#define MOUSE 9
#define SCROLL 10
&mt {
    flavor = "tap-preferred";
    tapping_term_ms = <180>;
};

&lt {
    tapping_term_ms = <150>;
    flavor = "hold-preferred";
};
/ {
    behaviors {
        b_tap_hold: b_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
        hm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
        hm_shift: home_row_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <170>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <0>;
            bindings = <&kp>, <&kp>;
        };
        blt: better_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        caps_word {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>;
            apply-to-combos;
        };
            };

    combos {
        compatible = "zmk,combos";
        combo_bootloader {
            timeout-ms = <30>;
            key-positions = <0 9>;
            bindings = <&bootloader>;
            layers = <0>;
            require-prior-idle-ms = <200>;
        };
        minus {
            timeout-ms = <30>;
            key-positions = <8 9>;
            bindings = <&kp MINUS>;
            require-prior-idle-ms = <175>;
            layers = <0>;
        };
        Grave {
            timeout-ms = <30>;
            key-positions = <0 1>;
            bindings = <&kp GRAVE>;
            require-prior-idle-ms = <175>;
            layers = <0>;
        };
        semi {
            timeout-ms = <30>;
            key-positions = <9 19>;
            bindings = <&kp SEMI>;
            require-prior-idle-ms = <175>;
            layers = <0>;
        };
        LParen {
            timeout-ms = <30>;
            key-positions = <3 4>;
            bindings = <&kp LPAR>;
            require-prior-idle-ms = <175>;
            layers = <0>;
        };
        RParen {
            timeout-ms = <30>;
            key-positions = <5 6>;
            bindings = <&kp RPAR>;
            require-prior-idle-ms = <175>;
            layers = <0>;
        };
        LBkt {
            timeout-ms = <30>;
            key-positions = <13 14>;
            bindings = <&kp LBKT>;
            require-prior-idle-ms = <175>;
            layers = <0>;
        };
        RBkt {
            timeout-ms = <30>;
            key-positions = <15 16>;
            bindings = <&kp RBKT>;
            require-prior-idle-ms = <175>;
            layers = <0>;
        };
        at {
            timeout-ms = <30>;
            key-positions = <1 2>;
            bindings = <&kp AT>;
            require-prior-idle-ms = <175>;
            layers = <0>;
        };
        CapsWord {
            timeout-ms = <30>;
            key-positions = <10 19>;
            bindings = <&caps_word>;
        };
        NumberLock {
            timeout-ms = <30>;
            key-positions = <20 29>;
            bindings = <&tog 1>;
        };
        stickySym {
            timeout-ms = <30>;
            key-positions = <30 35>;
            bindings = <&sl 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
                &kp Q    &kp W           &kp E       &kp R       &kp T        &kp Y     &kp U            &kp I     &kp O    &kp P
                &hm_shift LSHFT A   &hm LGUI S           &hm LALT D       &hm LCTRL F       &kp G        &kp H     &hm RCTRL J            &hm RALT K     &hm RGUI L    &hm_shift RSHFT SQT
                &blt 1 Z   &kp X     &kp C       &kp V       &blt 5 B        &kp N     &kp M            &kp COMMA &kp DOT  &blt 1 FSLH
                                        &kp TAB   &blt 2 DEL  &blt 3 ENTER  &blt 4 SPACE &blt 2 BSPC  &kp ESC
            >;
        };

        Numbers {
            bindings = <
                &kp N1       &kp N2       &kp N3       &kp N4       &kp N5       &kp N6       &kp N7       &kp N8       &kp N9       &kp N0
                &hm_shift LSHFT LC(A)      &kp LC(S)      &kp SEMI      &kp LBKT      &kp RBKT      &kp BSLH      &kp COLON      &kp MINUS      &kp EQUAL      &hm_shift RSHFT SEMI
                &kp LC(Z)       &kp LC(X)       &kp LC(C)       &kp LC(V)       &tog 1       &kp PLUS       &kp GRAVE       &kp COMMA       &kp DOT      &kp FSLH
                                        &trans      &trans      &trans      &trans      &trans      &trans
            >;
        };

        Symbols {
            bindings = <
                &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT   &kp CARET   &kp AMPS    &kp STAR    &kp LPAR    &kp RPAR
                &hm_shift LSHFT GRAVE   &kp TILDE   &kp MINUS   &kp PLUS   &kp LBKT       &kp RBKT        &kp BSLH        &kp SEMI        &kp COLON        &hm_shift RSHFT BSLH
                &none       &none       &none    &none   &kp LBRC       &kp RBRC       &kp EQUAL       &kp COMMA   &kp DOT     &none
                                        &trans      &trans      &trans      &none      &trans      &trans
            >;
        };

        Navigation {
            bindings = <
                &none           &none          &none    &none    &none      &kp PG_UP       &kp HOME    &kp UP      &kp END     &kp BSPC
                &kp LSHFT         &kp LGUI           &kp LALT    &kp LCTRL    &none           &kp PG_DN       &kp LEFT    &kp DOWN    &kp RIGHT   &kp RSHFT
                &kp LC(Z)           &kp LC(X)           &kp LC(C)    &kp LC(V)    &none    &kp K_APP       &kp LC(V)  &kp LC(C)    &kp LC(X)  &kp LC(Z)
                                                &trans          &trans          &none          &none      &trans      &trans
            >;
        };

        Function {
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10
                &hm_shift LSHFT F11 &kp F12 &none &kp C_BRI_DN &kp C_BRI_UP &none &kp RCTRL &kp RALT &kp RGUI &kp RSHFT
                &none &kp C_MUTE &none &kp C_VOL_DN &kp C_VOL_UP &none &none &none &none &studio_unlock
                &none &kp LCTRL &kp LGUI &none &kp RALT &kp ESC
            >;
        };

        MacroBluetooth {
            bindings = <
                &dm DM_SLOT_NVS 0  &dm DM_SLOT_NVS 1  &dm DM_SLOT_NVS 2  &dm DM_SLOT_NVS 3 &dm DM_SLOT_NVS 4 &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
                &dm DM_SLOT_RAM 0  &dm DM_SLOT_RAM 1  &dm DM_SLOT_RAM 2  &dm DM_SLOT_RAM 3 &dm DM_SLOT_RAM 4 &none &none &none &none &none
                &dm DM_REC 0       &dm DM_STP 0       &dm DM_DEL 0       &dm DM_STATE 0 &none &none &none &none &none &none
                &none &none &soft_off &out OUT_TOG &bt BT_CLR &none
            >;
        };

        Mouse {
            bindings = <
                &none &none &mkp RCLK &mkp MCLK &mkp LCLK &mkp LCLK &mkp MCLK &mkp RCLK &none &none
                &none &none &none &mo 7 &none &none &mo 7 &none &none &none
                &none &none &none &none &none &none &none &none &none &none
                &none &trans &none &none &none &none
            >;
        };

        Scroll {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
