// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define ALPHA       0
#define SYMBOL 2
#define NUMBER 1
#define NAVIGATION 3

&mt {
    flavor = "tap-preferred";
    tapping_term_ms = <180>;
};

&lt {
    tapping_term_ms = <150>;
    flavor = "hold-preferred";
};

/ {
    combos {
        compatible = "zmk,combos";
        combo_bootloader {
            timeout-ms = <50>;
            key-positions = <0 9>;
            bindings = <&bootloader>;

        };
        minus {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&kp MINUS>;
        };
        Grave {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp GRAVE>;
        };
        semi {
            timeout-ms = <50>;
            key-positions = <9 19>;
            bindings = <&kp SEMI>;
        };
        LParen {
            timeout-ms = <50>;
            key-positions = <3 4>;
            bindings = <&kp LPAR>;
        };
        RParen {
            timeout-ms = <50>;
            key-positions = <5 6>;
            bindings = <&kp RPAR>;
        };
        LBkt {
            timeout-ms = <50>;
            key-positions = <13 14>;
            bindings = <&kp LBKT>;
        };
        RBkt {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp RBKT>;
        };
        at {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp AT>;
        };
        CapsWord {
            timeout-ms = <50>;
            key-positions = <31 34>;
            bindings = <&caps_word>;
        };
        stickySym {
            timeout-ms = <50>;
            key-positions = <30 35>;
            bindings = <&sl 2>;
        };
    };

    behaviors {

        shift_undo: shift_undo {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp LC(Z)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        ALPHA_layer {
            bindings = <
                &kp Q    &kp W           &kp E       &kp R       &kp T        &kp Y     &kp U            &kp I     &kp O    &kp P
                &kp A   &kp S           &kp D       &lt 3 F       &kp G        &kp H     &mt LGUI J            &mt RCTRL K     &mt RALT L    &kp SQT
                &mt LSHFT Z   &kp X     &kp C       &kp V       &kp B        &kp N     &kp M            &kp COMMA &kp DOT  &mt RSHFT FSLH
                                        &lt 1 TAB   &mt LCTRL DEL  &mt LGUI ENTER  &lt 4 SPACE &kp BSPC  &lt 1 ESC
            >;
        };

        NUMBER_layer {
            bindings = <
                &kp N1       &kp N2       &kp N3       &kp N4       &kp N5       &kp N6       &kp N7       &kp N8       &kp N9       &kp N0
                &kp LC(A)      &kp LC(S)      &kp SEMI      &kp LBKT      &kp N5      &kp BSLH      &kp COLON      &kp MINUS      &kp EQUAL      &tog 1
                &shift_undo       &kp LC(X)       &kp LC(C)       &kp LC(V)       &none       &kp PLUS       &kp GRAVE       &kp COMMA       &kp DOT      &mt RSHFT FSLH
                                        &trans      &trans      &trans      &trans      &trans      &trans
            >;
        };

        SYMBOL_layer {
            bindings = <
                &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT   &kp CARET   &kp AMPS    &kp STAR    &kp LPAR    &kp RPAR
                &kp GRAVE   &kp TILDE   &kp MINUS   &kp PLUS   &kp LBKT       &kp RBKT        &kp BSLH        &kp SEMI        &kp COLON        &kp BSLH
                &kp LSHIFT       &none       &none    &none   &kp LBRC       &kp RBRC       &kp EQUAL       &kp COMMA   &kp DOT     &kp RSHIFT
                                        &trans      &tog 2      &none      &none      &tog 2      &trans
            >;
        };

        NAVIGATION_layer {
            bindings = <
                &none           &none          &none    &none    &none      &kp PG_UP       &kp HOME    &kp UP      &kp END     &kp BSPC
                &none         &none           &none    &none    &none           &kp PG_DN       &kp LEFT    &kp DOWN    &kp RIGHT   &kp RET
                &kp LSHIFT           &kp LCTRL           &none    &none    &none    &kp K_APP       &kp LC(X)  &kp LC(V)    &kp LC(V)  &kp RSHIFT
                                                &trans          &kp DEL          &kp LCTRL          &kp RALT      &kp LC(LS(L))      &trans
            >;
        };

        Function {
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10
                &kp F11 &kp F12 &none &kp C_BRI_DN &kp C_BRI_UP &none &kp RGUI &kp RCTRL &kp RALT &none
                &kp LSHIFT &kp C_MUTE &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &none &none &none &none &kp RSHIFT
                &none &kp LCTRL &kp LGUI &none &kp RALT &kp ESC
            >;
        };
    };
};
