// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define ALPHA       0
#define SYMBOL 2
#define NUMBER 1
#define NAVIGATION 3

&mt {
    flavor = "tap-preferred";
    tapping_term_ms = <180>;
};

&lt {
    tapping_term_ms = <150>;
    flavor = "hold-preferred";
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        cond_0_6_1 {
            if-layers = <0 2>;
            then-layer = <1>;
        };
    };

    behaviors {
        b_tap_hold: b_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        b_lt: b_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>; /* Change first parameter to &mo */
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_bootloader {
            timeout-ms = <50>;
            key-positions = <0 9>;
            bindings = <&bootloader>;
            layers = <0>;
        };
        minus {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&kp MINUS>;
            require-prior-idle-ms = <125>;
            layers = <0>;
        };
        Grave {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp GRAVE>;
            require-prior-idle-ms = <125>;
            layers = <0>;
        };
        semi {
            timeout-ms = <50>;
            key-positions = <9 19>;
            bindings = <&kp SEMI>;
            require-prior-idle-ms = <125>;
            layers = <0>;
        };
        LParen {
            timeout-ms = <50>;
            key-positions = <3 4>;
            bindings = <&kp LPAR>;
            require-prior-idle-ms = <125>;
            layers = <0>;
        };
        RParen {
            timeout-ms = <50>;
            key-positions = <5 6>;
            bindings = <&kp RPAR>;
            require-prior-idle-ms = <125>;
            layers = <0>;
        };
        LBkt {
            timeout-ms = <50>;
            key-positions = <13 14>;
            bindings = <&kp LBKT>;
            require-prior-idle-ms = <125>;
            layers = <0>;
        };
        RBkt {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp RBKT>;
            require-prior-idle-ms = <125>;
            layers = <0>;
        };
        at {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp AT>;
            require-prior-idle-ms = <125>;
            layers = <0>;
        };
        CapsWord {
            timeout-ms = <50>;
            key-positions = <31 34>;
            bindings = <&caps_word>;
        };
        stickySym {
            timeout-ms = <50>;
            key-positions = <30 35>;
            bindings = <&sl 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
                &lt 6 Q    &kp W           &kp E       &kp R       &kp T        &kp Y     &kp U            &kp I     &kp O    &kp P
                &mt LSHFT A   &mt LALT S           &mt LALT D       &mt LGUI F       &kp G        &kp H     &mt LGUI J            &mt RCTRL K     &mt RALT L    &mt RSHFT SQT
                &kp Z   &kp X     &kp C       &kp V       &kp B        &kp N     &kp M            &kp COMMA &kp DOT  &kp FSLH
                                        &b_lt 1 TAB   &kp DEL  &lt 4 ENTER  &lt 5 SPACE &lt 3 BSPC  &lt 1 ESC
            >;
        };

        Numbers {
            bindings = <
                &kp N1       &kp N2       &kp N3       &kp N4       &kp N5       &kp N6       &kp N7       &kp N8       &kp N9       &kp N0
                &b_tap_hold LSHIFT LC(A)      &kp LC(S)      &kp SEMI      &kp LBKT      &kp RBKT      &kp BSLH      &kp COLON      &kp MINUS      &kp EQUAL      &mt RSHFT SEMI
                &kp Z       &kp LC(X)       &kp LC(C)       &kp LC(V)       &to 2       &kp PLUS       &kp GRAVE       &kp COMMA       &kp DOT      &kp FSLH
                                        &trans      &trans      &trans      &trans      &trans      &trans
            >;
        };

        NumberLock {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &to 0 &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };

        Symbols {
            bindings = <
                &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT   &kp CARET   &kp AMPS    &kp STAR    &kp LPAR    &kp RPAR
                &kp GRAVE   &kp TILDE   &kp MINUS   &kp PLUS   &kp LBKT       &kp RBKT        &kp BSLH        &kp SEMI        &kp COLON        &kp BSLH
                &kp LSHIFT       &none       &none    &none   &kp LBRC       &kp RBRC       &kp EQUAL       &kp COMMA   &kp DOT     &kp RSHIFT
                                        &trans      &tog 3      &none      &none      &tog 3      &trans
            >;
        };

        Navigation {
            bindings = <
                &none           &none          &none    &none    &none      &kp PG_UP       &kp HOME    &kp UP      &kp END     &kp BSPC
                &kp LSHIFT         &kp LCTRL           &kp RALT    &kp LCMD    &none           &kp PG_DN       &kp LEFT    &kp DOWN    &kp RIGHT   &kp RET
                &none           &none           &none    &none    &none    &kp K_APP       &kp LC(X)  &kp LC(V)    &kp LC(V)  &kp RSHIFT
                                                &trans          &trans          &none          &none      &trans      &trans
            >;
        };

        Function {
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10
                &kp F11 &kp F12 &none &kp C_BRI_DN &kp C_BRI_UP &none &kp RGUI &kp RCTRL &kp RALT &studio_unlock
                &kp LSHIFT &kp C_MUTE &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &none &none &none &none &kp RSHIFT
                &none &kp LCTRL &kp LGUI &none &kp RALT &kp ESC
            >;
        };

        Bluetooth {
            bindings = <
                &none &none &none &none &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
                &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none
                &none &none &soft_off &out OUT_TOG &bt BT_CLR &none
            >;
        };
    };
};
